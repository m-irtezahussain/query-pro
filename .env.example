# Cloudflare account identifier from the dashboard overview.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# API token with Account > Workers AI > Read permission.
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# Optional. This default model supports Workers AI JSON Mode.
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# AI context controls for large database schemas.
CLOUDFLARE_AI_MAX_TOKENS="4096"
AI_SCHEMA_MAX_TABLES="25"
AI_SCHEMA_MAX_COLUMNS_PER_TABLE="40"

# Optional comma-separated exact host allowlist for private/local database imports.
# Publicly resolved database hosts do not need to be listed.
DB_CONNECTION_ALLOWED_HOSTS=""

# Structured backend logging: debug, info, warn, or error.
LOG_LEVEL="info"

# Opt in only for short-term debugging. Result payloads can contain SQL/schema data.
# Passwords, tokens, authorization headers, cookies, and credentials stay redacted.
LOG_RESULT_PAYLOADS="false"

# APP_URL: The URL where this applet is hosted.
# Optional public URL for hosted deployments.
APP_URL="MY_APP_URL"
