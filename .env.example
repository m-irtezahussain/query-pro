# Cloudflare account identifier from the dashboard overview.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# API token with Account > Workers AI > Read permission.
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# Optional. This default model supports Workers AI JSON Mode.
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Optional comma-separated exact host allowlist for private/local database imports.
# Publicly resolved database hosts do not need to be listed.
DB_CONNECTION_ALLOWED_HOSTS=""

# APP_URL: The URL where this applet is hosted.
# Optional public URL for hosted deployments.
APP_URL="MY_APP_URL"
